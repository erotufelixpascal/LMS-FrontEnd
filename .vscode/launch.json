{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Angular (ng serve + Chrome)",
      "type": "pwa-chrome",                // ← Changed to pwa-chrome (this fixes the error)
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile"  // Clean profile to avoid conflicts
    },
    {
      "name": "Attach to Chrome (Manual ng serve)",
      "type": "pwa-chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200/*",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "Debug Karma Tests (ng test)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}